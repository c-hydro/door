{
  "TAGS": {
    "source": "CDSE-S3",
    "product": "swi",
    "prod_name": "CDSE-swi"
  },
  "DATASETS": {
    "destination": {
      "type": "local",
      "path": "output/{source}/{product}/%Y/%m/%d/{variable}",
      "filename": "{prod_name}_{variable}_%Y%m%d.tif"
    }
  },
  "DOOR_DOWNLOADER": {
    "source": "{source}",
    "product": "{product}",
    "bounds": [-180,-90,180,90],
    "destination": "{DATASETS.destination}",
    "options": {
      "variables" : ["SWI015", "QFLAG015", "VOBS015"]
    }
  }
}