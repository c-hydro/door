{
    "TAGS":{
        "source"   : "GLOFAS",
        "product"  : "cems-glofas-historical"
    },
    "DATASETS":{
        "destination" : {
            "type" : "local",
            "path" : "output/{source}/{variable}/%Y/",
            "filename" : "{variable}_sample_%Y%m%d.tif"
        }
    },
    "DOOR_DOWNLOADER" :             {
        "source"    : "{source}",
        "product"   : "{product}",
        "destination" : "{DATASETS.destination}",
        "bounds" : [8, 38.5, 10, 41.5],
        "options" : {
            "variables" : ["soil_wetness_index"],
            "agg_method" : [["mean"]],
            "ts_per_year" : 12,
            "ts_per_year_agg" : 12
        }
    }
}