{
  "TAGS": {
    "source": "GSMAP",
    "product": "GSMAP-gauge",
    "domain": "africa",
    "version": "2.7.4",
    "title": "DOOR - JAXA GSMaP satellite precipitation"
  },
  "DATASETS": {
    "destination": {
      "type": "local",
      "path": "output/{source}/{domain}/%Y/%m/%d/",
      "filename": "{domain}_gsmap_gauge_%Y%m%d%H%M.tif"
    }
  },
  "DOOR_DOWNLOADER": {
    "source": "{source}",
    "product": "{product}",
    "destination": "{DATASETS.destination}",
    "bounds": [
      -20,
      -40,
      55,
      40
    ],
    "options": {
      "variables": {
        "precipitation": {
          "source_name": "precipitation_rate",
          "output_name": "precipitation_rate",
          "units": "mm h-1"
        }
      },
      "download_workers": 4,
      "download_attempts": 4,
      "retry_seconds": 5,
      "timeout_seconds": 120,
      "sleep_between_requests": 0,
      "minimum_file_size": 100000,
      "overwrite_existing": false,
      "validate_existing": true,
      "fail_on_missing": false,
      "fail_if_all_missing": true,
      "retry_not_found": false,
      "output_dtype": "float32",
      "output_nodata": -99,
      "compression": "deflate",
      "compression_level": 6,
      "tiled": true,
      "block_size": 256,
      "host": "hokusai.eorc.jaxa.jp",
      "port": 21,
      "protocol": "ftp",
      "remote_path_template": null,
      "remote_filename_template": null,
      "source_scale_factor": 1
    }
  },
  "workflow_name": "gsmap_gauge_standard_example",
  "workflow_log": {
    "file": "log/satellite/gsmap_gauge_standard_example_{now:%Y%m%d%H%M}.log",
    "level": "INFO",
    "console": true
  },
  "exec_options": {
    "repeat_window": "10h"
  }
}
