{
  "TAGS": {
    "source": "CMC_GDPS",
    "product": "GDPS0p15",
    "domain": "africa",
    "version": "2.7.4",
    "title": "DOOR - CMC GDPS forecast"
  },
  "DATASETS": {
    "destination": {
      "type": "local",
      "path": "output/{source}/{domain}/%Y/%m/%d/",
      "filename": "{domain}_cmc-gdps0p15_%Y%m%d%H.nc"
    }
  },
  "DOOR_DOWNLOADER": {
    "source": "{source}",
    "product": "{product}",
    "destination": "{DATASETS.destination}",
    "bounds": [
      -20,
      -40,
      55,
      40
    ],
    "options": {
      "frc_max_step": 120,
      "variables": {
        "APCP_SFC_0": "tp",
        "UGRD_TGL_10": "10u",
        "VGRD_TGL_10": "10v"
      },
      "convert_temperature_to_c": true,
      "aggregate_wind_components": true,
      "decumulate_precipitation": true,
      "decumulate_radiation": true,
      "hourly_output": true,
      "download_workers": 4,
      "download_attempts": 3,
      "retry_seconds": 5,
      "timeout_seconds": 180
    }
  },
  "workflow_name": "cmc_gdps_forecast",
  "workflow_log": {
    "file": "log/CMC/door_cmc_gdps_{now:%Y%m%d%H%M}.log",
    "level": "INFO",
    "console": true
  }
}
