{
    "TAGS":{
        "source"   : "CLMS",
        "product"  : "fapar",
        "prod_name": "CLMS-fapar"
    },
    "DATASETS":{
        "destination" : {
            "type" : "local",
            "path" : "output/{source}/{product}/%Y/{variable}",
            "filename" : "{prod_name}_{variable}_sample_%Y%m%d.tif"
        }
    },
    "DOOR_DOWNLOADER" : {
        "source"    : "{source}",
        "product"   : "{product}",
        "destination" : "{DATASETS.destination}",
        "bounds" : [-180, -90, 180, 90],
        "options" : {
            "accept_RTs" : ["RT6", "RT0"],
            "variables"  : ["FAPAR", "NOBS", "QFLAG"]
        }
    }
}