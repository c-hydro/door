{
    "TAGS":{
        "source"   : "JRA",
        "product"  : "JRA-3Q",
        "prod_name": "{source}-{product}"
    },
    "DATASETS":{
        "destination" : {
            "type" : "local",
            "path" : "output/{source}/{product}/{variable}/%Y",
            "filename" : "{product}_{variable}_{agg_method}_%Y%m%d.tif"
        }
    },
    "DOOR_DOWNLOADER" : {
        "source"    : "{source}",
        "product"   : "{product}",

        "destination" : "{DATASETS.destination}",
        "bounds" : [8, 38.5, 10, 41.5],
        "options" : {
            "freq" : "d",
            "variables" : ["precipitation", "temperature"],
            "agg_method" : ["sum", ["min", "max", "mean"]],
            "resolution" : 0.375
        }
    }
}