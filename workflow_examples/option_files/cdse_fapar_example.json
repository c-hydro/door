{
  "TAGS": {
    "source": "CDSE",
    "product": "fapar",
    "prod_name": "CDSE-fapar"
  },
  "DATASETS": {
    "destination": {
      "type": "local",
      "path": "output/{source}/{product}/%Y/{variable}",
      "filename": "{prod_name}_{variable}_%Y%m%d_{tile}.tif"
    },
    "mask":{
      "type": "local",
      "path": "/home/luca/Desktop",
      "filename": "global_fapar-s3_mask.tif"
    }
  },
  "DOOR_DOWNLOADER": {
    "source": "{source}",
    "product": "{product}",
    "bounds": [-180,-90,180,90],
    "destination": "{DATASETS.destination}",
    "options": {
      "consolidation": [0,6],
      "mosaicking_order": "mostRecent",
      "variables" : ["FAPAR"],
      "make_mosaic" : false,
      "skip_empty_tiles": true,
      "mask":"{DATASETS.mask}"
    }
  }
}