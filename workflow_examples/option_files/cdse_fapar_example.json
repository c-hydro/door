{
  "TAGS": {
    "source": "cdse",
    "product": "fapar",
    "prod_name": "CDSE-fapar"
  },
  "DATASETS": {
    "destination": {
      "type": "local",
      "path": "output/{source}/{product}/%Y/{variable}",
      "filename": "{prod_name}_{variable}_%Y%m%d.tif"
    }
  },
  "DOOR_DOWNLOADER": {
    "source": "{source}",
    "product": "{product}",
    "bounds": [8.0, 38.5, 10.0, 41.5],
    "destination": "{DATASETS.destination}",
    "options": {
      "consolidation": 6,
      "resolution": 300,
      "variables": ["FAPAR", "NOBS", "QFLAG"],
      "mosaicking_order": "mostRecent",
      "sample_type": "FLOAT32"
    }
  }
}