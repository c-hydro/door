{
  "TAGS": {
    "source": "CDSE",
    "product": "fapar",
    "prod_name": "CDSE-fapar"
  },
  "DATASETS": {
    "destination": {
      "type": "local",
      "path": "output/{source}_Europe/{product}/%Y/%m/%d/{variable}",
      "filename": "{prod_name}_{variable}_%Y%m%d.tif"
    }
  },
  "DOOR_DOWNLOADER": {
    "source": "{source}",
    "product": "{product}",
    "bounds": [-26 ,34, 41, 71],
    "destination": "{DATASETS.destination}",
    "options": {
      "consolidation": [0,6],
      "mosaicking_order": "mostRecent",
      "variables" : ["FAPAR", "QFLAG"],
      "make_mosaic" : false,
      "max_workers": 1
    }
  }
}