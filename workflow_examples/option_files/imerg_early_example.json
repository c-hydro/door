{
  "TAGS": {
    "source": "IMERG",
    "product": "IMERG-early",
    "domain": "africa",
    "version": "2.7.4",
    "title": "DOOR - NASA GPM IMERG satellite precipitation"
  },
  "DATASETS": {
    "destination": {
      "type": "local",
      "path": "output/{source}/{domain}/%Y/%m/%d/",
      "filename": "{domain}_imerg_%Y%m%d%H%M_mm_30min.tif"
    }
  },
  "DOOR_DOWNLOADER": {
    "source": "{source}",
    "product": "{product}",
    "destination": "{DATASETS.destination}",
    "bounds": [
      35,
      -1,
      47,
      11
    ],
    "options": {
      "variables": {
        "precipitation": {
          "source_name": "precipitation_accumulation",
          "output_name": "precipitation",
          "units": "mm/30min"
        }
      },
      "download_workers": 4,
      "download_attempts": 4,
      "retry_seconds": 5,
      "timeout_seconds": 120,
      "sleep_between_requests": 0,
      "minimum_file_size": 1000,
      "overwrite_existing": false,
      "validate_existing": true,
      "fail_on_missing": false,
      "fail_if_all_missing": true,
      "retry_not_found": false,
      "output_dtype": "float32",
      "output_nodata": 29999,
      "compression": "deflate",
      "compression_level": 6,
      "tiled": true,
      "block_size": 256,
      "version": "latest",
      "historical_version_fallback": true,
      "scaling_mode": "legacy",
      "fallback_to_early": false
    }
  },
  "workflow_name": "imerg_early_example",
  "workflow_log": {
    "file": "log/satellite/imerg_early_example_{now:%Y%m%d%H%M}.log",
    "level": "INFO",
    "console": true
  },
  "exec_options": {
    "repeat_window": "10h"
  }
}
