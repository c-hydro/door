{
  "TAGS": {
    "source": "CDSE",
    "product": "fapar",
    "prod_name": "CDSE-fapar"
  },
  "DATASETS": {
    "destination": {
      "type": "local",
      "path": "output/{source}_Italy/{product}/%Y/%m/%d/{variable}",
      "filename": "{prod_name}_{variable}_%Y%m%d_{tile}.tif"
    }
  },
  "DOOR_DOWNLOADER": {
    "source": "{source}",
    "product": "{product}",
    "bounds": [6.7, 36.6, 18.5, 47.2],
    "destination": "{DATASETS.destination}",
    "options": {
      "consolidation": [0,6],
      "mosaicking_order": "mostRecent",
      "variables" : ["FAPAR", "QFLAG"],
      "make_mosaic" : false,
      "max_workers": 4,
      "tvalue" : 50
    }
  }
}